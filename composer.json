{
    "name": "diversworld/contao-dw-api-bundle",
    "description": "API-Bundle für den Contao Diveclub Manager zur Kommunikation mit der iOS-App (https://apps.apple.com/de/app/diveclub-manager/id6759004094). Ermöglicht die Verwaltung von Events, Reservierungen, Ausrüstung und Kursfortschritten.",
    "keywords": [
        "contao",
        "contao-bundle",
        "diveclub",
        "api",
        "ios-app",
        "diving",
        "equipment-management",
        "course-management",
        "diversworld"
    ],
    "type": "contao-bundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Eckhard Becker",
            "email": "info@diversworld.eu",
            "homepage": "https://github.com/diversworld",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/diversworld/contao-dw-api-bundle/issues",
        "source": "https://github.com/diversworld/contao-dw-api-bundle"
    },
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3",
        "symfony/security-bundle": "^6.4 || ^7.0",
        "diversworld/contao-diveclub-bundle": "^3.4"
    },
    "require-dev": {
        "contao/easy-coding-standard": "^6.13",
        "contao/manager-plugin": "^2.12",
        "contao/test-case": "^5.3",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Diversworld\\ContaoDwApiBundle\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "contao-community-alliance/composer-plugin": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "contao-manager-plugin": "Diversworld\\ContaoDwApiBundle\\ContaoManager\\Plugin"
    },
    "scripts": {
        "unit-tests": "@php tools/phpunit/vendor/bin/phpunit -c tools/phpunit/phpunit.xml.dist",
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check config/ contao/ src/ templates/ tests/ --config tools/ecs/config/default.php --fix --ansi"
    }
}
